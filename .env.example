APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------- AI Business Brain ----------------
BRAIN_PROVIDER=openai              # openai|anthropic|gemini|groq|deepseek|mistral|xai|openrouter|together|azure|ollama|lmstudio
BRAIN_EMBEDDING_PROVIDER=openai    # openai|gemini|mistral|ollama|null (null = keyword search only)
BRAIN_EMBEDDING_DIMENSIONS=1536    # openai text-embedding-3-small=1536, gemini=768/1536/3072, nomic-embed-text=768
BRAIN_VECTOR_STORE=database        # database (MySQL/MariaDB/SQLite/Postgres) | pgvector (Postgres + extension)
BRAIN_BUSINESS_NAME="Your Company"
BRAIN_BUSINESS_DESCRIPTION="What you sell, to whom, where."
BRAIN_TONE="professional, warm and concise"
BRAIN_REQUIRE_APPROVAL=true
BRAIN_WEBHOOK_URL=                 # n8n / Zapier / Make webhook for the trigger_automation tool
BRAIN_RATE_LIMIT=60
#BRAIN_TEMPERATURE=0.3             # leave unset for reasoning models (gpt-5, o-series)
BRAIN_MAX_TOKENS=2048

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1
LMSTUDIO_ENABLED=false

# ---------------- SaaS ----------------
SAAS_NAME="AI Business Brain"
SAAS_TRIAL_DAYS=14
SAAS_ALLOW_REGISTRATION=true

# Stripe billing (Laravel Cashier). Webhook endpoint: https://your-app/stripe/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
CASHIER_CURRENCY=usd

# ---------------- Production / scale ----------------
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# DB_READ_HOST=replica1,replica2
# OCTANE_SERVER=frankenphp
# HORIZON_MAX_PROCESSES=64
# TRUSTED_PROXIES=*

# ---------------- Security & compliance ----------------
BRAIN_ENCRYPT_AT_REST=true
BRAIN_FORCE_HTTPS=false
BRAIN_PASSWORD_MIN=12
BRAIN_PASSWORD_UNCOMPROMISED=true
BRAIN_LOCKOUT_ATTEMPTS=8
BRAIN_LOCKOUT_MINUTES=15
# Providers you have a signed BAA with (usable in HIPAA mode)
BRAIN_HIPAA_PROVIDERS=ollama,lmstudio
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DISKS=local
STRIPE_PRICE_ENTERPRISE=

# ---------------- Single sign-on (leave empty to hide) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------- Monitoring ----------------
PULSE_ENABLED=true
# PULSE_INGEST_DRIVER=redis   # at scale, buffer metrics in Redis and run `php artisan pulse:work`
